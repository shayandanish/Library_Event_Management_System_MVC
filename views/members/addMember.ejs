<!DOCTYPE html>
<html>
  <head>
    <title>Add Member</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-2xl bg-white p-8 rounded-2xl shadow-lg">
      <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold text-slate-800">Add New Member</h1>
        <p class="text-slate-500 mt-1">Fill in the details below</p>
      </div>

      <!-- Admin Action Feedback Modal -->
      <% if (typeof msg !== 'undefined' && msg) { 
        const isError = /invalid|required|error|duplicate/i.test(msg);
      %>
      <div
        id="adminFeedbackModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm transition-opacity"
        role="dialog"
        aria-modal="true"
        aria-labelledby="feedbackTitle"
      >
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-100 p-6 sm:p-7 text-center transform transition-all">
          <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-2xl <%= !isError ? 'bg-emerald-50 text-emerald-600 ring-8 ring-emerald-50/50' : 'bg-rose-50 text-rose-600 ring-8 ring-rose-50/50' %> mb-4">
            <% if (!isError) { %>
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <% } else { %>
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <% } %>
          </div>

          <h3 id="feedbackTitle" class="text-xl font-bold text-slate-900 mb-2">
            <%= !isError ? 'Member Saved' : 'Action Failed' %>
          </h3>

          <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            <%= msg %>
          </p>

          <button
            type="button"
            onclick="closeFeedbackModal()"
            class="w-full inline-flex justify-center items-center px-5 py-3 rounded-xl font-semibold text-sm text-white shadow-sm transition <%= !isError ? 'bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800' : 'bg-rose-600 hover:bg-rose-700 active:bg-rose-800' %>"
          >
            OK, Continue
          </button>
        </div>
      </div>
      <% } %>

      <% if (typeof msg !== 'undefined' && msg) { %>
      <div
        class="mb-4 p-3 rounded-xl <%= /invalid|required|error|duplicate/i.test(msg) ? 'bg-rose-50 border border-rose-200 text-rose-800' : 'bg-green-50 border border-green-200 text-green-800' %>"
      >
        <%= msg %>
      </div>
      <% } %>

      <form method="post" action="/members/add" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1"
            >Member Name<span class="text-red-500">*</span></label
          >
          <input
            name="fullName"
            type="text"
            required
            class="w-full border border-slate-300 focus:border-slate-500 focus:ring focus:ring-slate-200 rounded-lg px-3 py-2"
            placeholder="e.g Shayan Danish"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Contact Number</label>
          <input
            name="phone"
            type="text"
            class="w-full border border-slate-300 focus:border-slate-500 focus:ring focus:ring-slate-200 rounded-lg px-3 py-2"
            placeholder="+92 3xx xxx xxxx"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1"
            >Email (Gmail preferred)</label
          >
          <input
            name="email"
            type="email"
            class="w-full border border-slate-300 focus:border-slate-500 focus:ring focus:ring-slate-200 rounded-lg px-3 py-2"
            placeholder="name@gmail.com"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1"
              >Member Type<span class="text-red-500">*</span></label
            >
            <select
              name="memberType"
              required
              class="w-full border border-slate-300 focus:border-slate-500 focus:ring focus:ring-slate-200 rounded-lg px-3 py-2"
            >
              <option value="">-- select --</option>
              <option value="student">Student</option>
              <option value="teacher">Teacher</option>
              <option value="staff">Staff</option>
              <option value="foreigner">Foreigner</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1"
              >Gender<span class="text-red-500">*</span></label
            >
            <select
              name="gender"
              required
              class="w-full border border-slate-300 focus:border-slate-500 focus:ring focus:ring-slate-200 rounded-lg px-3 py-2"
            >
              <option value="">-- select --</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <div class="pt-2">
          <button
            class="px-5 py-2 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition font-medium"
          >
            Save Member
          </button>
          <a href="/" class="ml-3 underline">Back</a>
        </div>
      </form>
    </div>

    <script>
      function closeFeedbackModal() {
        const modal = document.getElementById("adminFeedbackModal");
        if (modal) {
          modal.classList.add("hidden");
        }
        if (window.history.replaceState) {
          const url = new URL(window.location);
          url.searchParams.delete("msg");
          window.history.replaceState({}, document.title, url.toString());
        }
      }

      window.addEventListener("click", (e) => {
        const fbModal = document.getElementById("adminFeedbackModal");
        if (fbModal && e.target === fbModal) closeFeedbackModal();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeFeedbackModal();
      });
    </script>
  </body>
</html>
