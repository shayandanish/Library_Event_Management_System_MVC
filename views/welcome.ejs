<!DOCTYPE html>
<html>
  <head>
    <title>Library — Welcome</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <div class="container py-4 py-md-5">
      <!-- Top bar: title (mobile) + logout -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0 d-md-none">AIPS Library — Admin</h2>
        <form action="/admin/logout" method="POST" class="ms-auto">
          <button type="submit" class="btn btn-outline-danger btn-sm">
            Logout
          </button>
        </form>
      </div>

      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center p-3 p-md-4">
              <h1 class="mb-1 fs-4 fs-md-3">
                Welcome to the AIPS Library Islamabad
              </h1>
              <p class="text-muted mb-3 mb-md-4">Quick actions for librarian</p>

              <!-- Primary actions: big buttons, stacked on mobile -->
              <div
                class="d-flex flex-column flex-sm-row justify-content-center align-items-stretch gap-2 gap-sm-3 mt-2"
              >
                <a
                  href="/members/add"
                  class="btn btn-primary btn-lg w-100 w-sm-auto"
                  >Add Member</a
                >
                <a
                  href="/books"
                  class="btn btn-outline-secondary btn-lg w-100 w-sm-auto"
                  >View Books</a
                >
                <a
                  href="/members/list"
                  class="btn btn-outline-secondary btn-lg w-100 w-sm-auto"
                  >Registered Members</a
                >
              </div>
            </div>
          </div>

          <!-- Book Management Section -->
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">📚 Book Management</h5>
            </div>
            <div class="card-body">
              <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 flex-wrap">
                <a href="/books/add" class="btn btn-primary w-100 w-sm-auto">
                  Add Books
                </a>

                <button
                  class="btn btn-outline-primary w-100 w-sm-auto"
                  data-bs-toggle="modal"
                  data-bs-target="#issueModal"
                >
                  Issue Book
                </button>

                <button
                  class="btn btn-outline-success w-100 w-sm-auto"
                  data-bs-toggle="modal"
                  data-bs-target="#returnModal"
                >
                  Return Book
                </button>

                <button
                  class="btn btn-outline-warning w-100 w-sm-auto"
                  data-bs-toggle="modal"
                  data-bs-target="#updateModal"
                >
                  Update Book
                </button>

                <button
                  class="btn btn-outline-danger w-100 w-sm-auto"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteBookModal"
                >
                  Delete Book
                </button>
              </div>
            </div>
          </div>

          <!-- Post Management Section (NEW) -->
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0">📰 Post Management (Office Events)</h5>
            </div>
            <div class="card-body">
              <div class="d-flex flex-column gap-3">
                <a href="/admin/create-post" class="btn btn-success btn-lg w-100">
                  Create Post
                </a>
                <a href="/admin/update-post" class="btn btn-outline-primary btn-lg w-100">
                   Update Post
                </a>
                <a href="/admin/delete-post" class="btn btn-outline-danger btn-lg w-100">
                   Delete Post
                </a>
              </div>
            </div>
          </div>

          <!-- Admin Action Feedback Modal (Bootstrap 5) -->
          <% 
            const fbMsg = (typeof query !== 'undefined' && query && (query.msg || query.success)) || null;
            const fbErr = (typeof query !== 'undefined' && query && (query.err || query.error)) || null;
            const hasFb = Boolean(fbMsg || fbErr);
          %>
          <% if (hasFb) { %>
          <div class="modal fade" id="adminFeedbackModal" tabindex="-1" aria-labelledby="adminFeedbackLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
              <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="modal-header border-0 pb-0 justify-content-end">
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center px-4 pb-4 pt-0">
                  <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle <%= fbMsg ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>" style="width: 64px; height: 64px;">
                    <% if (fbMsg) { %>
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                    <% } else { %>
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                      </svg>
                    <% } %>
                  </div>
                  <h5 class="modal-title fw-bold text-dark mb-2" id="adminFeedbackLabel">
                    <%= fbMsg ? 'Operation Successful' : 'Action Failed' %>
                  </h5>
                  <p class="text-secondary mb-4 leading-relaxed">
                    <%= fbMsg || fbErr %>
                  </p>
                  <button type="button" class="btn <%= fbMsg ? 'btn-success' : 'btn-danger' %> rounded-pill px-4 py-2 w-100 fw-semibold shadow-sm" data-bs-dismiss="modal">
                    OK, Continue
                  </button>
                </div>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Message banners -->
          <% if (typeof query !== 'undefined' && query && (query.msg || query.success)) { %>
          <div class="mt-3" style="max-width: 720px; margin: 0 auto">
            <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
              <%= query.msg || query.success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          </div>
          <% } %>
          <% if (typeof query !== 'undefined' && query && (query.err || query.error)) { %>
          <div class="mt-3" style="max-width: 720px; margin: 0 auto">
            <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
              <%= query.err || query.error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Issue Modal -->
    <div class="modal fade" id="issueModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="issueForm" class="modal-content" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Issue a Book</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label">Enter Book ID</label>
            <div class="input-group mb-3">
              <input
                type="text"
                id="issueBookId"
                class="form-control"
                placeholder="AIPSLIB000123 or Mongo _id"
                required
              />
              <button
                type="button"
                class="btn btn-outline-secondary"
                id="checkIssueBtn"
              >
                Check
              </button>
            </div>
            <div id="issueDetails" class="d-none">
              <div class="card mb-2">
                <div class="card-body">
                  <h6 id="iTitle" class="card-title mb-1"></h6>
                  <div class="small text-muted mb-2" id="iMeta"></div>
                  <div>
                    Total: <span id="iTotal"></span> | Available:
                    <span id="iAvailable"></span>
                  </div>
                </div>
              </div>
              <div id="issueWarn" class="alert alert-warning mt-2 d-none">
                No copies available.
              </div>
            </div>

            <!-- Member selection for issuing -->
            <div class="mb-3">
              <label for="issueUserSearch" class="form-label"
                >Search Member</label
              >
              <input
                type="text"
                id="issueUserSearch"
                class="form-control mb-2"
                placeholder="Name, ID, email or phone"
              />
              <label for="issueUserSelect" class="form-label"
                >Select Member</label
              >
              <select name="userId" id="issueUserSelect" class="form-select">
                <option value="">-- choose member --</option>
              </select>
            </div>
            <div id="issueError" class="alert alert-danger d-none mt-2"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
              Cancel
            </button>
            <button
              type="submit"
              id="issueSubmit"
              class="btn btn-primary"
              disabled
            >
              Issue
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Return Modal -->
    <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="returnForm" class="modal-content" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Return a Book</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label">Enter Book ID</label>
            <div class="input-group mb-3">
              <input
                type="text"
                id="returnBookId"
                class="form-control"
                placeholder="AIPSLIB000123 or Mongo _id"
                required
              />
              <button
                type="button"
                class="btn btn-outline-secondary"
                id="checkReturnBtn"
              >
                Check
              </button>
            </div>
            <div id="returnDetails" class="d-none">
              <div class="card mb-2">
                <div class="card-body">
                  <h6 id="rTitle" class="card-title mb-1"></h6>
                  <div class="small text-muted mb-2" id="rMeta"></div>
                  <div>
                    Total: <span id="rTotal"></span> | Available:
                    <span id="rAvailable"></span>
                  </div>
                </div>
              </div>
              <div id="returnWarn" class="alert alert-warning mt-2 d-none">
                All copies already returned.
              </div>
            </div>

            <div class="mb-3">
              <label for="returnUserSearch" class="form-label"
                >Search Member</label
              >
              <input
                type="text"
                id="returnUserSearch"
                class="form-control mb-2"
                placeholder="Name, ID, email or phone"
              />
              <label for="returnUserSelect" class="form-label"
                >Select Member</label
              >
              <select name="userId" id="returnUserSelect" class="form-select">
                <option value="">-- choose member --</option>
              </select>
            </div>
            <div id="returnError" class="alert alert-danger d-none mt-2"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
              Cancel
            </button>
            <button
              type="submit"
              id="returnSubmit"
              class="btn btn-success"
              disabled
            >
              Return
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Update Modal -->
    <div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="updateForm" class="modal-content" method="POST">
          <div class="modal-header">
            <h5 class="modal-title">Update a Book</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>

          <div class="modal-body">
            <div id="updateLookupSection">
              <label class="form-label text-muted small fw-semibold">1. Search Book to Update</label>
              <div class="input-group mb-3">
                <input
                  type="text"
                  id="updateBookId"
                  name="updateBookId"
                  class="form-control font-monospace"
                  placeholder="Enter current Book ID (e.g. AIPSLIB10000)"
                />
                <button
                  type="button"
                  class="btn btn-primary"
                  id="checkUpdateBtn"
                >
                  Find Book
                </button>
              </div>
            </div>

            <div id="updateError" class="alert alert-danger d-none"></div>

            <div id="updateFields" class="d-none">
              <div class="alert alert-light border py-2 px-3 small mb-3 d-flex justify-content-between align-items-center">
                <span>Editing: <strong id="uFoundTitle"></strong></span>
                <span class="badge bg-secondary" id="uFoundCurrentId"></span>
              </div>

              <div class="mb-3 bg-primary-subtle p-3 rounded border border-primary-subtle">
                <label class="form-label fw-bold text-primary mb-1">
                  ✏️ New Book ID <span class="text-danger">*</span>
                </label>
                <input
                  type="text"
                  name="bookID"
                  id="uBookId"
                  class="form-control font-monospace fw-bold fs-6 border-primary"
                  required
                />
                <div class="form-text small">
                  Edit the Book ID here (e.g. change <code>AIPSLIB10000</code> to <code>AIPSLIB1286</code>). Duplicates will be rejected.
                </div>
              </div>
              <div class="mb-2">
                <label class="form-label">Title</label>
                <input
                  type="text"
                  name="title"
                  id="uTitle"
                  class="form-control"
                  required
                />
              </div>
              <div class="mb-2">
                <label class="form-label">Author</label>
                <input
                  type="text"
                  name="author"
                  id="uAuthor"
                  class="form-control"
                />
              </div>
              <div class="mb-2">
                <label class="form-label">Category</label>
                <input
                  type="text"
                  name="category"
                  id="uCategory"
                  class="form-control"
                />
              </div>
              <div class="row">
                <div class="col mb-2">
                  <label class="form-label">Year</label>
                  <input
                    type="number"
                    name="year"
                    id="uYear"
                    class="form-control"
                  />
                </div>
                <div class="col mb-2">
                  <label class="form-label">Total Copies</label>
                  <input
                    type="number"
                    name="totalCopies"
                    id="uTotal"
                    class="form-control"
                    min="0"
                  />
                </div>
                <div class="col mb-2">
                  <label class="form-label">Available</label>
                  <input
                    type="number"
                    name="availableCopies"
                    id="uAvailable"
                    class="form-control"
                    min="0"
                  />
                </div>
              </div>
              <div class="row">
                <div class="col mb-2">
                  <label class="form-label">Shelf No</label>
                  <input
                    type="text"
                    name="shelfNo"
                    id="uShelfNo"
                    class="form-control"
                  />
                </div>
                <div class="col mb-2">
                  <label class="form-label">Shelf</label>
                  <input
                    type="text"
                    name="shelf"
                    id="uShelf"
                    class="form-control"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
              Cancel
            </button>
            <button
              type="submit"
              id="updateSubmit"
              class="btn btn-warning"
              disabled
            >
              Save changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Delete Book Modal -->
    <div class="modal fade" id="deleteBookModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form id="deleteBookForm" class="modal-content" method="POST">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title">Delete a Book</h5>
            <button
              type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label">Enter Book ID</label>
            <div class="input-group mb-3">
              <input
                type="text"
                id="deleteBookInput"
                class="form-control font-monospace"
                placeholder="AIPSLIB000123 or Mongo _id"
                required
              />
              <button
                type="button"
                class="btn btn-outline-secondary"
                id="checkDeleteBtn"
              >
                Check
              </button>
            </div>

            <div id="deleteError" class="alert alert-danger d-none"></div>

            <div id="deleteDetails" class="d-none">
              <div class="card mb-3 bg-light border-danger">
                <div class="card-body">
                  <h6 id="dTitle" class="card-title text-danger mb-1 fw-bold"></h6>
                  <div class="small text-muted mb-2" id="dMeta"></div>
                  <div>
                    Total Copies: <span id="dTotal" class="fw-bold"></span> | Available:
                    <span id="dAvailable" class="fw-bold"></span>
                  </div>
                </div>
              </div>

              <div id="deleteWarn" class="alert alert-warning d-none">
                <strong>Cannot Delete:</strong> Active copies are currently issued to members. Please ensure all copies are returned before deleting.
              </div>

              <p class="text-danger small mb-0">
                Are you sure you want to delete this book? Cancel leaves the record unchanged. Confirming will permanently remove it from the catalog.
              </p>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
              Cancel
            </button>
            <button
              type="submit"
              id="deleteSubmit"
              class="btn btn-danger"
              disabled
            >
              Confirm Delete
            </button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      // --- Common helper ---
      async function lookupBook(id) {
        try {
          const res = await fetch("/books/lookup/" + encodeURIComponent(id));
          if (!res.ok) return null;
          return (await res.json()).data;
        } catch {
          return null;
        }
      }

      // --- Issue ---
      const issueIdInput = document.getElementById("issueBookId");
      const issueBtn = document.getElementById("checkIssueBtn");
      const issueDetails = document.getElementById("issueDetails");
      const issueError = document.getElementById("issueError");
      const issueWarn = document.getElementById("issueWarn");
      const issueSubmit = document.getElementById("issueSubmit");
      const iTitle = document.getElementById("iTitle");
      const iMeta = document.getElementById("iMeta");
      const iTotal = document.getElementById("iTotal");
      const iAvailable = document.getElementById("iAvailable");

      async function doIssueLookup() {
        issueDetails.classList.add("d-none");
        issueError.classList.add("d-none");
        issueWarn.classList.add("d-none");
        issueSubmit.disabled = true;

        const id = issueIdInput.value.trim();
        if (!id) return;

        const data = await lookupBook(id);
        if (!data) {
          issueError.textContent = "Book not found";
          issueError.classList.remove("d-none");
          return;
        }

        iTitle.textContent = data.title || "(Untitled)";
        iMeta.textContent = [data.author, data.category, data.year]
          .filter(Boolean)
          .join(" • ");
        iTotal.textContent = data.total;
        iAvailable.textContent = data.available;
        issueDetails.classList.remove("d-none");

        if (!data.canIssue) {
          issueWarn.classList.remove("d-none");
        } else {
          issueSubmit.disabled = false;
        }
      }

      issueBtn.addEventListener("click", doIssueLookup);
      document
        .getElementById("issueForm")
        .addEventListener("submit", function (e) {
          const id = issueIdInput.value.trim();
          if (!id) return e.preventDefault();
          this.action = "/books/issue/" + encodeURIComponent(id);
        });

      // --- Return ---
      const returnIdInput = document.getElementById("returnBookId");
      const returnBtn = document.getElementById("checkReturnBtn");
      const returnDetails = document.getElementById("returnDetails");
      const returnError = document.getElementById("returnError");
      const returnWarn = document.getElementById("returnWarn");
      const returnSubmit = document.getElementById("returnSubmit");
      const rTitle = document.getElementById("rTitle");
      const rMeta = document.getElementById("rMeta");
      const rTotal = document.getElementById("rTotal");
      const rAvailable = document.getElementById("rAvailable");

      async function doReturnLookup() {
        returnDetails.classList.add("d-none");
        returnError.classList.add("d-none");
        returnWarn.classList.add("d-none");
        returnSubmit.disabled = true;

        const id = returnIdInput.value.trim();
        if (!id) return;

        const data = await lookupBook(id);
        if (!data) {
          returnError.textContent = "Book not found";
          returnError.classList.remove("d-none");
          return;
        }

        rTitle.textContent = data.title || "(Untitled)";
        rMeta.textContent = [data.author, data.category, data.year]
          .filter(Boolean)
          .join(" • ");
        rTotal.textContent = data.total;
        rAvailable.textContent = data.available;
        returnDetails.classList.remove("d-none");

        if (data.available >= data.total) {
          returnWarn.classList.remove("d-none");
        } else {
          returnSubmit.disabled = false;
        }
      }

      returnBtn.addEventListener("click", doReturnLookup);
      document
        .getElementById("returnForm")
        .addEventListener("submit", function (e) {
          const id = returnIdInput.value.trim();
          if (!id) return e.preventDefault();
          this.action = "/books/return/" + encodeURIComponent(id);
        });

      // --- Update ---
      const updateIdInput = document.getElementById("updateBookId");
      const checkUpdateBtn = document.getElementById("checkUpdateBtn");
      const updateError = document.getElementById("updateError");
      const updateFields = document.getElementById("updateFields");
      const updateSubmit = document.getElementById("updateSubmit");
      const uBookId = document.getElementById("uBookId");
      const uTitle = document.getElementById("uTitle");
      const uAuthor = document.getElementById("uAuthor");
      const uCategory = document.getElementById("uCategory");
      const uYear = document.getElementById("uYear");
      const uTotal = document.getElementById("uTotal");
      const uAvailable = document.getElementById("uAvailable");
      const uShelfNo = document.getElementById("uShelfNo");
      const uShelf = document.getElementById("uShelf");

      async function doUpdateLookup() {
        updateFields.classList.add("d-none");
        updateError.classList.add("d-none");
        updateSubmit.disabled = true;

        const id = updateIdInput.value.trim();
        if (!id) return;

        const data = await lookupBook(id);
        if (!data) {
          updateError.textContent = "Book not found";
          updateError.classList.remove("d-none");
          return;
        }

        uBookId.value = data.bookID || "";
        const uFoundTitle = document.getElementById("uFoundTitle");
        const uFoundCurrentId = document.getElementById("uFoundCurrentId");
        if (uFoundTitle) uFoundTitle.textContent = data.title || "(Untitled)";
        if (uFoundCurrentId) uFoundCurrentId.textContent = "Current ID: " + (data.bookID || "");

        uTitle.value = data.title || "";
        uAuthor.value = data.author || "";
        uCategory.value = data.category || "";
        uYear.value = data.year || "";
        uTotal.value = data.total ?? data.totalCopies ?? 0;
        uAvailable.value =
          data.available ?? data.availableCopies ?? (uTotal.value || 0);
        uShelfNo.value = data.shelfNo || "";
        uShelf.value = data.shelf || "";

        updateFields.classList.remove("d-none");
        updateSubmit.disabled = false;

        document.getElementById("updateForm").action =
          "/books/update/" + encodeURIComponent(data._id || id);
      }

      checkUpdateBtn.addEventListener("click", doUpdateLookup);

      // Two-way sync between search box and uBookId
      updateIdInput.addEventListener("input", () => {
        if (!updateFields.classList.contains("d-none") && updateIdInput.value.trim()) {
          uBookId.value = updateIdInput.value.trim();
        }
      });
      uBookId.addEventListener("input", () => {
        if (uBookId.value.trim()) {
          updateIdInput.value = uBookId.value.trim();
        }
      });

      document.getElementById("updateForm").addEventListener("submit", function (e) {
        if (!uBookId.value.trim() && updateIdInput.value.trim()) {
          uBookId.value = updateIdInput.value.trim();
        }
      });

      // --- Delete Book ---
      const deleteIdInput = document.getElementById("deleteBookInput");
      const checkDeleteBtn = document.getElementById("checkDeleteBtn");
      const deleteDetails = document.getElementById("deleteDetails");
      const deleteError = document.getElementById("deleteError");
      const deleteWarn = document.getElementById("deleteWarn");
      const deleteSubmit = document.getElementById("deleteSubmit");
      const dTitle = document.getElementById("dTitle");
      const dMeta = document.getElementById("dMeta");
      const dTotal = document.getElementById("dTotal");
      const dAvailable = document.getElementById("dAvailable");
      const deleteBookForm = document.getElementById("deleteBookForm");

      async function doDeleteLookup() {
        deleteDetails.classList.add("d-none");
        deleteError.classList.add("d-none");
        deleteWarn.classList.add("d-none");
        deleteSubmit.disabled = true;

        const id = deleteIdInput.value.trim();
        if (!id) return;

        const data = await lookupBook(id);
        if (!data) {
          deleteError.textContent = "Book not found";
          deleteError.classList.remove("d-none");
          return;
        }

        dTitle.textContent = `${data.title} (${data.bookID})`;
        dMeta.textContent = [data.author, data.category, data.year]
          .filter(Boolean)
          .join(" • ");
        dTotal.textContent = data.total;
        dAvailable.textContent = data.available;
        deleteDetails.classList.remove("d-none");

        // If issued copies exist, block deletion
        if (data.available < data.total) {
          deleteWarn.classList.remove("d-none");
          deleteSubmit.disabled = true;
        } else {
          deleteSubmit.disabled = false;
        }

        deleteBookForm.action = "/books/delete/" + encodeURIComponent(data._id || id);
      }

      checkDeleteBtn?.addEventListener("click", doDeleteLookup);
    </script>

    <script>
      async function loadMembers(
        selectId,
        { q = "", type = "", gender = "" } = {}
      ) {
        const params = new URLSearchParams();
        if (q) params.set("q", q);
        if (type) params.set("type", type);
        if (gender) params.set("gender", gender);

        const res = await fetch("/members?" + params.toString());
        const users = await res.json();
        const sel = document.getElementById(selectId);
        sel.innerHTML = '<option value="">-- choose member --</option>';
        users.forEach((u) => {
          const opt = document.createElement("option");
          opt.value = u._id;
          opt.textContent = `${u.fullName} (${u.memberID}) — ${u.memberType}`;
          sel.appendChild(opt);
        });
      }

      document
        .getElementById("issueModal")
        ?.addEventListener("show.bs.modal", () => {
          loadMembers("issueUserSelect");
        });
      document
        .getElementById("returnModal")
        ?.addEventListener("show.bs.modal", () => {
          loadMembers("returnUserSelect");
        });

      document
        .getElementById("issueUserSearch")
        ?.addEventListener("input", (ev) => {
          const q = ev.target.value || "";
          loadMembers("issueUserSelect", { q });
        });

      document
        .getElementById("returnUserSearch")
        ?.addEventListener("input", (ev) => {
          const q = ev.target.value || "";
          loadMembers("returnUserSelect", { q });
        });
    </script>

    <% if (hasFb) { %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const fbEl = document.getElementById("adminFeedbackModal");
        if (fbEl && typeof bootstrap !== "undefined" && bootstrap.Modal) {
          const fbModal = new bootstrap.Modal(fbEl);
          fbModal.show();
          fbEl.addEventListener("hidden.bs.modal", function () {
            if (window.history.replaceState) {
              const url = new URL(window.location);
              url.searchParams.delete("msg");
              url.searchParams.delete("err");
              url.searchParams.delete("success");
              url.searchParams.delete("error");
              window.history.replaceState({}, document.title, url.toString());
            }
          });
        }
      });
    </script>
    <% } %>
  </body>
</html>