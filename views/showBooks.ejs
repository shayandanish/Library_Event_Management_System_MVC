<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Books — AIPS Library</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .truncate-1 {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between"
      >
        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900">
            AIPS Books Catalog
          </h1>
          <p class="text-xs sm:text-sm text-slate-500">Explore and manage library resources</p>
        </div>
        <div class="flex items-center space-x-3">
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a
            href="/books/add"
            class="inline-flex items-center text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3.5 py-2 rounded-xl transition shadow-sm"
          >
            + Add Book
          </a>
          <a
            href="/admin/dashboard"
            class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3.5 py-2 rounded-xl transition"
          >
            Admin Dashboard
          </a>
          <% } %>
          <a href="/" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">Home</a>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <!-- Admin Action Feedback Modal -->
      <% 
        const feedbackMsg = (typeof query !== 'undefined' && query && (query.msg || query.success)) || null;
        const feedbackErr = (typeof query !== 'undefined' && query && (query.err || query.error)) || null;
        const hasFeedback = Boolean(feedbackMsg || feedbackErr);
      %>
      <% if (hasFeedback) { %>
      <div
        id="adminFeedbackModal"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm transition-opacity"
        role="dialog"
        aria-modal="true"
        aria-labelledby="feedbackTitle"
      >
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-100 p-6 sm:p-7 text-center transform transition-all">
          <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-2xl <%= feedbackMsg ? 'bg-emerald-50 text-emerald-600 ring-8 ring-emerald-50/50' : 'bg-rose-50 text-rose-600 ring-8 ring-rose-50/50' %> mb-4">
            <% if (feedbackMsg) { %>
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <% } else { %>
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <% } %>
          </div>

          <h3 id="feedbackTitle" class="text-xl font-bold text-slate-900 mb-2">
            <%= feedbackMsg ? 'Action Successful' : 'Action Failed' %>
          </h3>

          <p class="text-sm text-slate-600 mb-6 leading-relaxed">
            <%= feedbackMsg || feedbackErr %>
          </p>

          <button
            type="button"
            onclick="closeFeedbackModal()"
            class="w-full inline-flex justify-center items-center px-5 py-3 rounded-xl font-semibold text-sm text-white shadow-sm transition <%= feedbackMsg ? 'bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800' : 'bg-rose-600 hover:bg-rose-700 active:bg-rose-800' %>"
          >
            OK, Continue
          </button>
        </div>
      </div>
      <% } %>

      <!-- Success Flash Alert -->
      <% if (typeof query !== 'undefined' && query && query.msg) { %>
      <div
        class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 px-4 py-3 flex items-center justify-between shadow-sm"
      >
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-sm font-medium"><%= query.msg %></span>
        </div>
      </div>
      <% } %>

      <!-- Error Flash Alert -->
      <% if (typeof query !== 'undefined' && query && query.err) { %>
      <div
        class="mb-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 px-4 py-3 flex items-center justify-between shadow-sm"
      >
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
          <span class="text-sm font-medium"><%= query.err %></span>
        </div>
      </div>
      <% } %>

      <section class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
          <div class="flex items-center space-x-3">
            <h2 class="text-lg font-bold text-slate-800">All Books</h2>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
              Total: <%= totalBooks %>
            </span>
          </div>

          <!-- Search inputs -->
          <form method="GET" action="/books" class="flex flex-wrap items-center gap-2">
            <input
              type="text"
              name="title"
              value="<%= (query && query.title) || '' %>"
              placeholder="Search by title..."
              class="px-3 py-1.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
            <input
              type="text"
              name="author"
              value="<%= (query && query.author) || '' %>"
              placeholder="Author..."
              class="px-3 py-1.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
            <button
              type="submit"
              class="px-3.5 py-1.5 text-sm font-medium bg-slate-800 hover:bg-slate-900 text-white rounded-xl transition"
            >
              Filter
            </button>
            <% if ((query && query.title) || (query && query.author)) { %>
            <a href="/books" class="text-xs text-slate-500 hover:text-slate-800">Clear</a>
            <% } %>
          </form>
        </div>

        <% if (notFoundMessage) { %>
        <div class="px-6 py-3 bg-amber-50 text-amber-800 text-sm border-b border-amber-200 flex items-center space-x-2">
          <span><%= notFoundMessage %></span>
        </div>
        <% } %>

        <div class="overflow-x-auto">
          <table class="min-w-full table-fixed text-sm">
            <thead class="bg-slate-50 text-slate-700 border-b border-slate-200">
              <tr>
                <th class="text-left font-semibold px-4 py-3 w-32">Book ID</th>
                <th class="text-left font-semibold px-4 py-3">Title</th>
                <th class="text-left font-semibold px-4 py-3">Author</th>
                <th class="text-left font-semibold px-4 py-3 hidden sm:table-cell w-36">
                  Category
                </th>
                <th class="text-left font-semibold px-4 py-3 hidden md:table-cell w-20">
                  Year
                </th>
                <th class="text-left font-semibold px-4 py-3 hidden md:table-cell w-20">
                  Total
                </th>
                <th class="text-left font-semibold px-4 py-3 w-24">Available</th>

                <!-- Shelf columns: ALWAYS visible -->
                <th class="text-left font-semibold px-4 py-3 w-24">Shelf No</th>
                <th class="text-left font-semibold px-4 py-3 w-28">Shelf</th>

                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <th class="text-left font-semibold px-4 py-3 w-36">Actions</th>
                <% } %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (Array.isArray(books) && books.length) { %>
              <% books.forEach(function(book) { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td
                  class="px-4 py-3 font-mono font-medium text-slate-700 truncate-1"
                  title="<%= book.bookID || book.BookID || '' %>"
                >
                  <%= book.bookID || book.BookID || '' %>
                </td>
                <td
                  class="px-4 py-3 font-medium text-slate-900 truncate-1"
                  title="<%= book.title || book.Title || '' %>"
                >
                  <%= book.title || book.Title || '' %>
                </td>
                <td
                  class="px-4 py-3 text-slate-600 truncate-1"
                  title="<%= book.author || book.Author || '' %>"
                >
                  <%= book.author || book.Author || '' %>
                </td>
                <td
                  class="px-4 py-3 text-slate-600 truncate-1 hidden sm:table-cell"
                  title="<%= book.category || book.Category || '' %>"
                >
                  <%= book.category || book.Category || '' %>
                </td>
                <td class="px-4 py-3 text-slate-600 hidden md:table-cell">
                  <%= book.year || book.Year || '' %>
                </td>
                <td class="px-4 py-3 text-slate-600 hidden md:table-cell">
                  <%= (book.totalCopies ?? book.TotalCopies ?? 0) %>
                </td>
                <td class="px-4 py-3">
                  <% const avail = (book.availableCopies ?? book.AvailableCopies ?? 0); %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= avail > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>">
                    <%= avail %>
                  </span>
                </td>

                <!-- Shelf No + Shelf -->
                <td class="px-4 py-3 text-slate-600 font-mono text-xs">
                  <%= book.shelfNo || book.ShelfNo || '-' %>
                </td>
                <td
                  class="px-4 py-3 text-slate-600 truncate-1"
                  title="<%= book.shelf || book.Shelf || '' %>"
                >
                  <%= book.shelf || book.Shelf || '-' %>
                </td>

                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <td class="px-4 py-3">
                  <div class="flex items-center space-x-1.5">
                    <button
                      type="button"
                      data-id="<%= book._id %>"
                      onclick="handleEditClick(this)"
                      class="px-2.5 py-1 text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition"
                      title="Edit book details"
                    >
                      Edit
                    </button>
                    <button
                      type="button"
                      data-id="<%= book._id %>"
                      data-title="<%= book.title || book.Title || '' %>"
                      data-bookid="<%= book.bookID || book.BookID || '' %>"
                      onclick="handleDeleteClick(this)"
                      class="px-2.5 py-1 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition"
                      title="Delete this book"
                    >
                      Delete
                    </button>
                  </div>
                </td>
                <% } %>
              </tr>
              <% }) %>
              <% } else { %>
              <tr>
                <td colspan="10" class="px-4 py-8 text-center text-slate-500">
                  <%= notFoundMessage || "No books found in the catalog." %>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination controls -->
        <div
          class="px-6 py-4 border-t border-slate-200 flex justify-between items-center flex-col sm:flex-row gap-3 bg-white"
        >
          <!-- Previous Button -->
          <div>
            <% if (currentPage > 1) { %>
            <a
              href="/books?page=<%= currentPage - 1 %><%= (query && query.title) ? '&title=' + encodeURIComponent(query.title) : '' %><%= (query && query.author) ? '&author=' + encodeURIComponent(query.author) : '' %>"
              class="inline-flex items-center px-3.5 py-1.5 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
            >
              ← Previous
            </a>
            <% } %>
          </div>

          <!-- Page Information -->
          <span class="text-sm font-medium text-slate-600">
            Page <span class="text-slate-900 font-semibold"><%= currentPage %></span> of <span class="text-slate-900 font-semibold"><%= totalPages %></span>
          </span>

          <!-- Next Button -->
          <div class="flex items-center space-x-3">
            <% if (currentPage < totalPages) { %>
            <a
              href="/books?page=<%= currentPage + 1 %><%= (query && query.title) ? '&title=' + encodeURIComponent(query.title) : '' %><%= (query && query.author) ? '&author=' + encodeURIComponent(query.author) : '' %>"
              class="inline-flex items-center px-3.5 py-1.5 text-sm font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
            >
              Next →
            </a>
            <% } %>

            <!-- Direct Page Input -->
            <div class="flex items-center space-x-1.5">
              <input
                type="number"
                id="pageInput"
                class="w-16 px-2 py-1.5 text-sm text-center border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500"
                min="1"
                max="<%= totalPages %>"
                value="<%= currentPage %>"
              />
              <button
                type="button"
                onclick="goToPage()"
                class="px-3 py-1.5 text-sm font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition"
              >
                Go
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Delete Confirmation Modal (Admin Only) -->
    <div id="deleteModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 transform transition-all">
        <div class="flex items-start space-x-3 mb-4">
          <div class="p-2.5 bg-rose-100 rounded-xl text-rose-600 shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Confirm Book Deletion</h3>
            <p class="text-sm text-slate-500 mt-0.5">Are you sure you want to delete this book record? Cancel will leave the record unchanged.</p>
          </div>
        </div>

        <div class="bg-slate-50 rounded-xl p-3.5 mb-5 border border-slate-200">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Target Record</div>
          <div id="deleteModalBookTitle" class="text-sm font-bold text-slate-800"></div>
          <div id="deleteModalBookID" class="text-xs font-mono text-indigo-700 mt-0.5"></div>
        </div>

        <div class="text-xs text-rose-600 bg-rose-50 p-3 rounded-xl border border-rose-200 mb-5">
          <strong>Safety check:</strong> Books with active issues or unreturned copies cannot be deleted.
        </div>

        <form id="deleteForm" method="POST" class="flex items-center justify-end space-x-3">
          <button
            type="button"
            onclick="closeDeleteModal()"
            class="px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-5 py-2 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition shadow-sm"
          >
            Delete Book
          </button>
        </form>
      </div>
    </div>

    <!-- Edit Book Modal (Admin Only) -->
    <div id="editModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto">
      <div class="bg-white rounded-2xl shadow-xl max-w-xl w-full p-6 my-8">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
          <h3 class="text-lg font-bold text-slate-900">Edit Book</h3>
          <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
        </div>

        <form id="editForm" method="POST" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Book ID -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Book ID</label>
              <input
                type="text"
                id="editBookId"
                name="bookID"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 font-mono font-medium focus:ring-2 focus:ring-indigo-500"
                required
              />
              <span class="text-xs text-slate-400">Can be updated; duplicates rejected.</span>
            </div>

            <!-- Title -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Title *</label>
              <input
                type="text"
                id="editTitle"
                name="title"
                required
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Author -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Author</label>
              <input
                type="text"
                id="editAuthor"
                name="author"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Category -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Category</label>
              <input
                type="text"
                id="editCategory"
                name="category"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Year -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Year</label>
              <input
                type="number"
                id="editYear"
                name="year"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Total Copies -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Total Copies</label>
              <input
                type="number"
                id="editTotal"
                name="totalCopies"
                min="0"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Available Copies -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Available Copies</label>
              <input
                type="number"
                id="editAvailable"
                name="availableCopies"
                min="0"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Shelf No -->
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Shelf No</label>
              <input
                type="text"
                id="editShelfNo"
                name="shelfNo"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <!-- Shelf -->
            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-slate-700 mb-1">Shelf Section</label>
              <input
                type="text"
                id="editShelf"
                name="shelf"
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500"
              />
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex justify-end space-x-3">
            <button
              type="button"
              onclick="closeEditModal()"
              class="px-4 py-2 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-5 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition shadow-sm"
            >
              Update Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function goToPage() {
        const page = document.getElementById("pageInput").value;
        if (!page) return;
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set("page", page);
        window.location.href = `/books?${urlParams.toString()}`;
      }

      // Delete Modal Handling
      const deleteModal = document.getElementById("deleteModal");
      const deleteForm = document.getElementById("deleteForm");
      const deleteModalBookTitle = document.getElementById("deleteModalBookTitle");
      const deleteModalBookID = document.getElementById("deleteModalBookID");

      function handleDeleteClick(btn) {
        const id = btn.getAttribute("data-id");
        const title = btn.getAttribute("data-title");
        const bookID = btn.getAttribute("data-bookid");
        openDeleteModal(id, title, bookID);
      }

      function handleEditClick(btn) {
        const id = btn.getAttribute("data-id");
        openEditModal(id);
      }

      function openDeleteModal(id, title, bookID) {
        if (!deleteModal) return;
        deleteModalBookTitle.textContent = title || "Untitled";
        deleteModalBookID.textContent = `ID: ${bookID}`;
        deleteForm.action = `/books/delete/${encodeURIComponent(id)}`;
        deleteModal.classList.remove("hidden");
      }

      function closeDeleteModal() {
        if (!deleteModal) return;
        deleteModal.classList.add("hidden");
      }

      // Edit Modal Handling
      const editModal = document.getElementById("editModal");
      const editForm = document.getElementById("editForm");
      const editBookId = document.getElementById("editBookId");
      const editTitle = document.getElementById("editTitle");
      const editAuthor = document.getElementById("editAuthor");
      const editCategory = document.getElementById("editCategory");
      const editYear = document.getElementById("editYear");
      const editTotal = document.getElementById("editTotal");
      const editAvailable = document.getElementById("editAvailable");
      const editShelfNo = document.getElementById("editShelfNo");
      const editShelf = document.getElementById("editShelf");

      async function openEditModal(id) {
        try {
          const res = await fetch(`/books/lookup/${encodeURIComponent(id)}`);
          if (!res.ok) return alert("Could not fetch book details.");
          const result = await res.json();
          if (!result.ok || !result.data) return alert("Book not found.");

          const data = result.data;
          editBookId.value = data.bookID || "";
          editTitle.value = data.title || "";
          editAuthor.value = data.author || "";
          editCategory.value = data.category || "";
          editYear.value = data.year || "";
          editTotal.value = data.total ?? 1;
          editAvailable.value = data.available ?? 1;
          editShelfNo.value = data.shelfNo || "";
          editShelf.value = data.shelf || "";

          editForm.action = `/books/update/${encodeURIComponent(id)}`;
          editModal.classList.remove("hidden");
        } catch (e) {
          alert("Error opening edit modal: " + e.message);
        }
      }

      function closeEditModal() {
        if (!editModal) return;
        editModal.classList.add("hidden");
      }

      function closeFeedbackModal() {
        const modal = document.getElementById("adminFeedbackModal");
        if (modal) {
          modal.classList.add("hidden");
        }
        if (window.history.replaceState) {
          const url = new URL(window.location);
          url.searchParams.delete("msg");
          url.searchParams.delete("err");
          url.searchParams.delete("success");
          url.searchParams.delete("error");
          window.history.replaceState({}, document.title, url.toString());
        }
      }

      // Close modals on clicking outside or ESC
      window.addEventListener("click", (e) => {
        if (e.target === deleteModal) closeDeleteModal();
        if (e.target === editModal) closeEditModal();
        const fbModal = document.getElementById("adminFeedbackModal");
        if (fbModal && e.target === fbModal) closeFeedbackModal();
      });
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeDeleteModal();
          closeEditModal();
          closeFeedbackModal();
        }
      });
    </script>
  </body>
</html>
